; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Find Great Deal"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[audio]

driver/enable_input=true
driver/mix_rate=48000

[layer_names]

3d_physics/layer_1="World"

[autoload]

NetworkManager="*res://scripts/NetworkManager.cs"
VoiceManager="*res://scripts/voice/VoiceManager.cs"
Telemetry="*res://scripts/telemetry/Telemetry.cs"
ActiveDevice="*res://scripts/controls/ActiveDevice.cs"
; F9 screenshot key. Last, because it depends on nothing above it — and an autoload rather than
; a per-scene node so it exists in every scene, including ones written after it. Inert headless.
DevScreenshot="*res://scripts/dev/DevScreenshot.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="SuperFindGreatDeal"

[gui]

theme/custom="res://resources/UITheme.tres"

