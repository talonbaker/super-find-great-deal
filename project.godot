[rendering]

renderer/rendering_method.mobile="forward_plus"
; ART-BIBLE §4.4 says desktop compression only, and that is still what every desktop build uses:
; import_s3tc_bptc stays true and Windows/Linux go on selecting bptc/s3tc for every texture,
; unchanged. What import_etc2_astc does is add a SECOND, mobile-format copy ALONGSIDE those. It
; replaces nothing, and no desktop build ever loads one.
;
; W7-7, 2026-08-30 -- flipped false -> true, and it is a requirement, not a drift. Talon:
; "I need both mac and PC. I need this to work for both for this playtest specifically testing
; connection between both platforms." Godot 4.7 ships exactly ONE macOS export template and it is
; universal (there is no Intel-only binary), and Godot REFUSES a universal export unless this flag
; is on. So: no line, no macOS build, no cross-platform playtest.
;
; The cost was measured rather than waved through: 17 textures gain an etc2 variant, the Windows
; .pck was proven unchanged across the flip (per-file MD5 comparison with a positive control on
; the comparator), and none of the 17 is reachable from the default play path. Evidence:
; docs/agents/roles/programming/outbox/2026-08-30-W7-7-the-mac-build-path.md
;
; If this ever goes back to false, know what that costs: it deletes the macOS build.
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=8

[shader_globals]

; BT-9, 2026-08-27. The bubble-test level's night-aid dial: 0 at noon, 1 at deep night.
;
; WRITTEN BY EXACTLY ONE THING -- `scripts/game/world/bubbletest/NightAidDriver.cs`, once per
; frame, from `OutdoorAtmosphere.Evaluate().NightFactor`. It is a REPUBLICATION of the curve the
; sky already uses, never a second derivation of it; see that file's class doc for why that
; distinction is load-bearing in a repo where OutdoorAtmosphere is the single writer of darkness.
;
; READ BY `resources/shaders/night_edge.gdshader` (`global uniform float bt_darkness;`).
;
; TRAP: because the driver publishes every frame, a `--set bt_darkness=...` or an inspector poke
; is silently overwritten on the next frame and looks exactly like the uniform being ignored. Use
; night_edge's own `darkness_override` uniform to pin a value instead.
bt_darkness={
"type": "float",
"value": 0.0
}
