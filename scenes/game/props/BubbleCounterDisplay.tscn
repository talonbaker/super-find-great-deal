[gd_scene load_steps=10 format=3 uid="uid://bt8display0"]

[ext_resource type="Script" path="res://scripts/game/bubble/BubbleCounterDisplay.cs" id="1_display"]
; FIX-1 item 4, 2026-08-28. THE FONT IS NOT OPTIONAL ON A TextMesh AND ITS ABSENCE IS SILENT.
; With no `font` set, TextMesh falls back to the engine's built-in default face, which this
; Godot build CANNOT TRIANGULATE -- "Triangulation failed" fired once per SetText and the board
; rendered nothing at all, for pure-ASCII "0 / 6" as readily as for an em dash. So the glyph was
; never the problem and neither was the string: the FONT was. WorkSans is a real outline TTF
; imported by `font_data_dynamic` with `multichannel_signed_distance_field=false`, i.e. it has
; the contours a mesh needs. Do not remove this line to "tidy up"; the failure it prevents is
; invisible in the editor and only shows in a render.
[ext_resource type="FontFile" uid="uid://c87jur5rbcxuu" path="res://assets/fonts/WorkSans.ttf" id="2_font"]

[sub_resource type="BoxMesh" id="BoxMesh_board"]
size = Vector3(3.2, 1.6, 0.24)

[sub_resource type="BoxShape3D" id="BoxShape3D_board"]
size = Vector3(3.2, 1.6, 0.24)

[sub_resource type="BoxMesh" id="BoxMesh_post"]
