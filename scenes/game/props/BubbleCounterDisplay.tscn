[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_glyph"]
albedo_color = Color(0.86, 0.95, 1, 1)
roughness = 0.6
emission_enabled = true
emission = Color(0.78, 0.92, 1, 1)
; 2.0, RE-DERIVED FROM A CAPTURE LADDER (COUNTER-1, 2026-08-29). THE PREMISE, NOT THE ARITHMETIC,
; IS WHAT CHANGED -- READ THIS BEFORE MOVING THE NUMBER AGAIN.
;
; This was 40, then 200. The 200 was honestly measured (FIX-1, 2026-08-28) against a night fog
; near 1.0 m^-1 that crushed the glyphs to a peak of 0.395 at 6 m and to total extinction by 8 m.
; DARK-1 (2026-08-28) then set this world's night sight range to 28 m -- 0.107 m^-1 -- and ENABLED
; A GLOW PASS. Both halves of the 200's premise were gone. Talon played it and said the board was
; "completely over blown ... too bright ... and it's blurry", and he was right three times over.
;
; SO THE LESSON IS NOT "200 WAS TOO BIG". It is that an emissive value is a reading of the
; atmosphere it sits in, and this one outlived its atmosphere silently. If the fog, the sight
; range, the tonemap or the glow threshold move again, RE-SHOOT THE LADDER -- do not scale this.
; Rig: docs/qa/bubble-test/COUNTER-1/Counter1Capture.ps1; metric: measure.py beside it. Both
; cameras are projected from this board's own face, so range is the only variable.
;
; THE LADDER, headed 1920x1080, day AND night, 6 m and 20 m from the south face (all four columns
; are in the COUNTER-1 report). "board lift" is how far the bloom raises the board's OWN dark
; housing in daylight above its unbloomed floor of 14.9 -- i.e. how much of Talon's "the camera
; makes it overblown" is left:
;
;   mult   board lift (day)   20 m night peak   6 m night clipped   verdict
;    200      +84.8            unreadable blob        31.4 %        the shipped defect
;      8      +62.2                 244                9.3 %        DARK-1's proposal -- still a
;                                                                   blown halo, the board is gone
;      3      +14.4                 187                7.5 %        good, but a daylight haze
;      2      +1.0                  160                0.0 %        <-- SHIPPED
;    1.4      +0.0                  137                0.0 %        no bloom left at all
;
; 2.0 is the HIGHEST rung at which the glow adds essentially nothing to the board's own face
; (+1.0 of 255) while BT-8 acceptance criterion 3 -- "readable at 20 m at night" -- still passes,
; with a 151-point glyph-to-board swing over a background at 7.7. Above it the bloom starts
; washing the housing in daylight; below it the night read is being spent for nothing.
;
; AND THE GLOW THRESHOLD WAS JUDGED WITH IT, NOT AFTER IT. OutdoorAtmosphere's GlowHdrThreshold
; (1.15) and GlowHdrLuminanceCap (2.2) are DARK-1's and are single-writer. Raising the threshold
; to tame this board would un-bloom the BUBBLES, which DARK-1 had to push from 0.8 to 2.4
; emission specifically to clear 1.15. The material is the correct lever and it is measured to be
; sufficient: at 2.0 the bleed is gone without touching the environment at all.
;
; THIS IS STILL NOT AN EXPOSURE CHANGE. One emissive material on one prop -- exactly the knob D10
; leaves to the board as "the one lit thing in the hub". Nothing shared moves.
emission_energy_multiplier = 2.0

[sub_resource type="TextMesh" id="TextMesh_glyphs"]
