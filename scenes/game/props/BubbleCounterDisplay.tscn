[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_housing"]
albedo_color = Color(0.14, 0.15, 0.17, 1)
roughness = 0.85

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_post"]
albedo_color = Color(0.2, 0.21, 0.23, 1)
