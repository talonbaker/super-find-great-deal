[sub_resource type="BoxMesh" id="BoxMesh_cereal"]
size = Vector3(0.19, 0.28, 0.06)

[sub_resource type="BoxShape3D" id="BoxShape3D_cereal"]
size = Vector3(0.19, 0.28, 0.06)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_cereal"]
resource_local_to_scene = true
albedo_color = Color(0.78, 0.26, 0.2, 1)
roughness = 0.85
metallic = 0.0
emission_enabled = true
emission = Color(0.78, 0.26, 0.2, 1)
emission_energy_multiplier = 0.14

; THE BAND: a stripe right across the face rather than a ring, because a cereal box is a flat
; thing that stands with one face out and a ring round its waist would be invisible from the
; aisle. 3 mm proud on every axis (0.196 x 0.05 x 0.066 against the box's 0.19 x 0.28 x 0.06),
; so it catches the light from the front AND shows as an edge from the side.
[sub_resource type="BoxMesh" id="BoxMesh_band"]
size = Vector3(0.196, 0.05, 0.066)

; The shared gold; see DealCan.tscn's header for why 0.30 emission, why it is by value rather
; than a .tres, and why it must NOT be the material Carryable pulses.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(0.95, 0.78, 0.22, 1)
roughness = 0.3
metallic = 0.75
emission_enabled = true
emission = Color(0.95, 0.78, 0.22, 1)
emission_energy_multiplier = 0.3

; SHELF-1 (2026-09-19) — A GREAT DEAL CEREAL BOX: CerealBox.tscn with a gold stripe and nothing
; else changed. The collider, the 0.4 kg mass, the size class and the warm mid red are the
; ordinary box's to the digit; see DealCan.tscn's header for why that is the whole design and
; not laziness, and CerealBox.tscn for the cube-vs-box discrimination the unchanged collider
; keeps true (Shape.Box -> PropMaterial.Cardboard -> PropKind.Box).
;
; FOR BTN-1: root type is RigidBody3D, exactly as SFX-1's three prefabs are, so the rack's
; existing instance lines keep working unchanged when this file replaces the placeholder.
[node name="DealBox" type="RigidBody3D"]
mass = 0.4
script = ExtResource("1_carryable")
kind = 3
material = 2
tint = Color(0.78, 0.26, 0.2, 1)

[node name="Visual" type="Node3D" parent="."]

[node name="MeshInstance3D" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("BoxMesh_cereal")
material_override = SubResource("StandardMaterial3D_cereal")

[node name="DealBand" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("BoxMesh_band")
material_override = SubResource("StandardMaterial3D_gold")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_cereal")

[node name="Interactable" type="Node" parent="."]
