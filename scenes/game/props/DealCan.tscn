; THE BAND, and it is the only thing that tells this can from the forty-seven around it.
; 0.026 m tall, 2 mm proud of the can's own 0.035 m radius: it is a ring you can see from the
; side at aisle range and cannot see at all from directly above, which is the point -- the
; seeker has to look ALONG a shelf, not walk past it.
[sub_resource type="CylinderMesh" id="CylinderMesh_band"]
top_radius = 0.037
bottom_radius = 0.037
height = 0.026

; ONE GOLD, SHARED BY ALL THREE DEAL PREFABS BY VALUE (each scene carries its own copy rather
; than a .tres, so a deal object is still one self-contained file BTN-1 can instance). Emission
; 0.30 is deliberately above every product's 0.12-0.18 and deliberately below anything that
; would light the aisle: THRILL-BIBLE Part II's 2026-08-30 ruling is that a prop may glow and
; may not light, and a near-miss that glowed enough to be found from the doorway would delete
; the search. It is NOT resource_local_to_scene and NOT the material Carryable pulses -- the
; highlight drives Visual/MeshInstance3D's override only, so the band stays a constant gold
; while the body of the can brightens under the cursor. The band is identity; the pulse is
; affordance; they are different jobs and must not share a dial.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(0.95, 0.78, 0.22, 1)
roughness = 0.3
metallic = 0.75
emission_enabled = true
emission = Color(0.95, 0.78, 0.22, 1)
emission_energy_multiplier = 0.3

; SHELF-1 (2026-09-19) — A GREAT DEAL CAN: Can.tscn with a gold band and nothing else changed.
;
; THE COLLIDER, THE MASS, THE SIZE CLASS AND THE MATERIAL VOICE ARE THE ORDINARY CAN'S, TO THE
; DIGIT. Same CylinderShape3D r 0.035 x h 0.12, same 0.35 kg, same silver-grey albedo/roughness/
; metallic/emission. That is the whole design (PROPOSAL-2026-09-19-SOUND-STATES S2): the hider's
; choice of object is the choice of WHICH POPULATION IT HIDES IN, and the seeker tells a deal
; item from its neighbours by the band alone. A deal can that were fractionally bigger, heavier
; or shinier would be findable by silhouette, and the near-miss would stop being a near-miss.
;
; Because the collider is unchanged, Carryable.ShapeFromCollider still answers Can, which still
; answers PropMaterial.Tin and PropKind.Can — so this rings like tin, is pickled by the tin
; profile, and rides the wire as a can. Nothing new had to be taught anything.
;
; Structure, the `mass`-is-the-only-export-that-arrives note, and the deliberate absence of a
; `layers` line are Can.tscn's; read them there rather than having two copies drift.
;
; FOR BTN-1: root type is RigidBody3D, exactly as SFX-1's three prefabs are, so the rack's
; existing instance lines keep working unchanged when this file replaces the placeholder.
[node name="DealCan" type="RigidBody3D"]
mass = 0.35
script = ExtResource("1_carryable")
kind = 2
material = 1
tint = Color(0.74, 0.76, 0.79, 1)

[node name="Visual" type="Node3D" parent="."]

[node name="MeshInstance3D" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("CylinderMesh_can")
material_override = SubResource("StandardMaterial3D_can")

[node name="DealBand" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("CylinderMesh_band")
material_override = SubResource("StandardMaterial3D_gold")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CylinderShape3D_can")

[node name="Interactable" type="Node" parent="."]
script = ExtResource("2_interactable")
