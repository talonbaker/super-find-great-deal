[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/game/sandbox/Carryable.cs" id="1_carryable"]
[ext_resource type="Script" path="res://scripts/game/sandbox/feel/Interactable.cs" id="2_interactable"]

[sub_resource type="SphereMesh" id="SphereMesh_sortball"]
radius = 0.08
height = 0.16

[sub_resource type="SphereShape3D" id="SphereShape3D_sortball"]
radius = 0.08

; No colour here. See SortCube.tscn's note -- SortItem paints it from SortPalette, and white is
; what a sortable whose SortItem never ran looks like.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_sortball"]
resource_local_to_scene = true
roughness = 0.6
metallic = 0.0

; TASK-1 (2026-09-19). A sortable BALL: 0.08 m radius, 0.25 kg.
;
; Structure, the colour note and the render-layer-19 note are SortCube.tscn's; read them there.
;
; TWO THINGS SPECIFIC TO THIS PREFAB.
;
;   THE RADIUS IS LOAD-BEARING. Carryable.ShapeFromCollider splits a sphere at
;   Carryable.ProduceVsBallRadiusM (0.17 m), so 0.08 resolves to Shape.Produce -- which is what
;   the packet asked for (a ball sounds like produce) and is also what SortItem.ShapeOf maps to
;   SortShape.Ball. Growing this past 0.17 would silently turn every ball into the foundation's
;   wooden ball and change how it sounds without changing how it sorts.
;
;   IT IS DAMPED, and Produce.tscn learned this the hard way: an undamped sphere on a flat floor
;   never stops. Here it matters twice over -- a ball that keeps rolling inside a bin never
;   satisfies SortTally's rest test and would never score, and one that rolls back OUT is a sort
;   the player made and did not get.
[node name="SortBall" type="RigidBody3D"]
mass = 0.25
linear_damp = 2.0
angular_damp = 3.0
script = ExtResource("1_carryable")
kind = 4

[node name="Visual" type="Node3D" parent="."]

[node name="MeshInstance3D" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("SphereMesh_sortball")
material_override = SubResource("StandardMaterial3D_sortball")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("SphereShape3D_sortball")

[node name="Interactable" type="Node" parent="."]
script = ExtResource("2_interactable")
