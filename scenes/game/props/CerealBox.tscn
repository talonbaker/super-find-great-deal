[sub_resource type="BoxShape3D" id="BoxShape3D_cereal"]
size = Vector3(0.19, 0.28, 0.06)

; ONE FLAT COLOUR, per the packet, and a warm mid red — not a print, not a logo, not a second
; albedo. The search room's whole premise is aisles of near-identical product that the hider's
; one object has to hide among, so a box that is individually interesting is a box that ruins
; the level. Roughness 0.85, metallic 0: paper does not shine. Emission 0.14 for the same
; reason as the can's 0.18.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_cereal"]
resource_local_to_scene = true
albedo_color = Color(0.78, 0.26, 0.2, 1)
roughness = 0.85
metallic = 0.0
emission_enabled = true
emission = Color(0.78, 0.26, 0.2, 1)
emission_energy_multiplier = 0.14

; SFX-1 (2026-09-19). A cereal box: cardboard, 0.4 kg, 190 x 280 x 60 mm.
;
; Structure, the mass note and the render-layer-19 note are Can.tscn's, verbatim in intent; read
; them there rather than having three copies drift.
;
; THE ONE THING SPECIFIC TO THIS PREFAB: its collider is a box, and so is the foundation crate's,
; so the shape alone cannot tell them apart. What can is that a crate is a CUBE (0.44 on every
; axis) and a cereal box is emphatically not — Carryable.ShapeFromCollider tests exactly that,
; "are all three extents equal", which is a meaningful question rather than a magic threshold.
; A future box-shaped product that happens to be cubic would break that and must set its own
; Profile export instead; that is the escape hatch, and it is why the export wins over the
; collider rather than the other way round.
[node name="CerealBox" type="RigidBody3D"]
mass = 0.4
script = ExtResource("1_carryable")
kind = 3
material = 2
tint = Color(0.78, 0.26, 0.2, 1)
; PHYS-1 (2026-09-20), ruling P4 -- THE ROW THAT MAKES A ROW OF BOXES DOMINO.
; Native properties only; friction (0.75, the highest of the carryables) is on the shared
; PhysicsMaterial and is the other half of this.
;
; THE CENTRE OF MASS IS THE DESIGN. A 0.19 x 0.28 x 0.06 box standing on its smallest face is
; already tippy; moving its centre of mass to y = +0.07 -- a quarter of its height above the
; geometric centre, i.e. three quarters of the way up -- is what makes a NUDGE enough, which is
; what Talon asked for ("accidentally hit a bunch of boxes"). center_of_mass_mode 1 is CUSTOM;
; without it the vector below is ignored and the body computes its own from the collider.
; PHYS-1 applies a wake impulse at the CONTACT POINT rather than at the centre of mass
; (NetworkedProp.WakeFromContactServer), so the lever and the top-heaviness compose: a box struck
; high goes over, a box struck at the base slides a little.
;
; angular_damp 1.2 against the can's 0.25 -- five times -- so a box that has fallen stops flat
; instead of rocking on its corner for a second and a half. linear_damp 0.4: cardboard on a board
; does not glide.
physics_material_override = ExtResource("3_physmat")
linear_damp = 0.4
; PHYS-1, RE-MEASURED 2026-09-20: 1.2 -> 0.5, on evidence rather than on taste. The first
; five runs of Run-PhysicsFeelTest put five of these in a row 2 cm apart and walked a body
; through them: boxes 1-3 went fully over (up-vector 1.00 -> 0.00) and box 3 came to rest
; TOUCHING box 4 -- its far edge at x 42.93 against box 4 at 42.93 -- without tipping it. A
; chain that arrives and cannot finish is angular damping eating the topple, and 1.2 was a
; guess. A cereal box in air has almost none; what damping is for here is settling it once it
; has landed, which 0.5 still does (the row is flat and still inside the 0.41 s window).
angular_damp = 0.5
center_of_mass_mode = 1
center_of_mass = Vector3(0, 0.07, 0)

