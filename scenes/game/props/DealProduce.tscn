[ext_resource type="Script" path="res://scripts/game/sandbox/feel/Interactable.cs" id="2_interactable"]

[sub_resource type="SphereMesh" id="SphereMesh_produce"]
radius = 0.08
height = 0.16

[sub_resource type="SphereShape3D" id="SphereShape3D_produce"]
radius = 0.08

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_produce"]
resource_local_to_scene = true
albedo_color = Color(0.92, 0.51, 0.13, 1)
roughness = 0.9
metallic = 0.0
emission_enabled = true
emission = Color(0.92, 0.51, 0.13, 1)
emission_energy_multiplier = 0.12

; THE BAND: a torus round the equator, which is the only band shape a sphere can wear. Inner
; 0.075 sinks 5 mm INTO the 0.08 m sphere so no gap shows at any angle; outer 0.088 stands 8 mm
; proud. TorusMesh's ring lies in XZ with its axis on Y, so no rotation is authored and none of
; .claude/rules/godot-scenes.md's basis-row trap is in play here.
[sub_resource type="TorusMesh" id="TorusMesh_band"]
inner_radius = 0.075
outer_radius = 0.088

; The shared gold; see DealCan.tscn's header for why 0.30 emission, why it is by value rather
; than a .tres, and why it must NOT be the material Carryable pulses.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(0.95, 0.78, 0.22, 1)
roughness = 0.3
metallic = 0.75
emission_enabled = true
emission = Color(0.95, 0.78, 0.22, 1)
emission_energy_multiplier = 0.3

; SHELF-1 (2026-09-19) — A GREAT DEAL PIECE OF PRODUCE: Produce.tscn with a gold ring and
; nothing else changed. The 0.08 m SphereShape3D, the 0.25 kg, the orange and — importantly —
; the linear/angular damping are the ordinary produce's to the digit; see DealCan.tscn's header
; for why, and Produce.tscn for why an undamped sphere on a flat floor never stops (measured:
; one rolled out of the room).
;
; The unchanged radius is what keeps Carryable.ShapeFromCollider's one arbitrary number honest:
; 0.08 is well under ProduceVsBallRadiusM (0.17), so this is Produce, not the foundation's ball,
; and it sounds and syncs like every other orange in the bins.
;
; FOR BTN-1: root type is RigidBody3D, exactly as SFX-1's three prefabs are, so the rack's
; existing instance lines keep working unchanged when this file replaces the placeholder.
[node name="DealProduce" type="RigidBody3D"]
mass = 0.25
linear_damp = 2.0
angular_damp = 3.0
script = ExtResource("1_carryable")
kind = 4
material = 3
tint = Color(0.92, 0.51, 0.13, 1)

