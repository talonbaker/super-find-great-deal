; Orange, per the packet, and matte: roughness 0.9, metallic 0. Emission 0.12, the lowest of the
; three — produce is the quietest thing in this wave in every sense, and a glowing orange in a
; dim aisle would be the first thing a seeker's eye goes to, which is the opposite of what an
; aisle of near-misses is for.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_produce"]
resource_local_to_scene = true
albedo_color = Color(0.92, 0.51, 0.13, 1)
roughness = 0.9
metallic = 0.0
emission_enabled = true
emission = Color(0.92, 0.51, 0.13, 1)
emission_energy_multiplier = 0.12

; SFX-1 (2026-09-19). A piece of produce: soft, 0.25 kg, 80 mm radius.
;
; Structure, the mass note and the render-layer-19 note are Can.tscn's; read them there.
;
; THE ONE THING SPECIFIC TO THIS PREFAB: like the cereal box it shares a collider TYPE with a
; foundation prop — the 0.26 m ball — so Carryable.ShapeFromCollider splits them on radius, at
; 0.17 m, which is the midpoint of 0.08 and 0.26 rather than a value hugging either. That is the
; one genuinely arbitrary number in the resolution table and it is named
; (Carryable.ProduceVsBallRadiusM) rather than typed inline for exactly that reason.
[node name="Produce" type="RigidBody3D"]
mass = 0.25
script = ExtResource("1_carryable")
kind = 4
material = 3
tint = Color(0.92, 0.51, 0.13, 1)

