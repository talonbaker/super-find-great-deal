[gd_scene load_steps=7 format=3 uid="uid://produce0sfgdmvp"]

[ext_resource type="Script" path="res://scripts/game/sandbox/Carryable.cs" id="1_carryable"]
[ext_resource type="Script" path="res://scripts/game/sandbox/feel/Interactable.cs" id="2_interactable"]
[ext_resource type="PhysicsMaterial" path="res://assets/physics/produce.tres" id="3_physmat"]

[sub_resource type="SphereMesh" id="SphereMesh_produce"]
radius = 0.08
height = 0.16

[sub_resource type="SphereShape3D" id="SphereShape3D_produce"]
radius = 0.08

; Orange, per the packet, and matte: roughness 0.9, metallic 0. Emission 0.12, the lowest of the
; three — produce is the quietest thing in this wave in every sense, and a glowing orange in a
; dim aisle would be the first thing a seeker's eye goes to, which is the opposite of what an
; aisle of near-misses is for.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_produce"]
resource_local_to_scene = true
albedo_color = Color(0.92, 0.51, 0.13, 1)
roughness = 0.9
metallic = 0.0
emission_enabled = true
emission = Color(0.92, 0.51, 0.13, 1)
emission_energy_multiplier = 0.12

; SFX-1 (2026-09-19). A piece of produce: soft, 0.25 kg, 80 mm radius.
;
; Structure, the mass note and the render-layer-19 note are Can.tscn's; read them there.
;
; THE ONE THING SPECIFIC TO THIS PREFAB: like the cereal box it shares a collider TYPE with a
; foundation prop — the 0.26 m ball — so Carryable.ShapeFromCollider splits them on radius, at
; 0.17 m, which is the midpoint of 0.08 and 0.26 rather than a value hugging either. That is the
; one genuinely arbitrary number in the resolution table and it is named
; (Carryable.ProduceVsBallRadiusM) rather than typed inline for exactly that reason.
[node name="Produce" type="RigidBody3D"]
mass = 0.25
; DAMPED, like Sphere.tscn and for the reason Sphere.tscn does not say: an undamped sphere on a
; flat floor never stops. Measured in the first run of tests/Run-MaterialSfxTest.ps1 -- a seeded
; produce dropped 0.27 m at z = -3 rolled to z = -4.92 and the server logged
; "rest not good prop=3 OutsideRoomBounds". An orange that leaves the aisle it was knocked off is
; a worse bug than a quiet one.
linear_damp = 2.0
angular_damp = 3.0
script = ExtResource("1_carryable")
kind = 4
material = 3
tint = Color(0.92, 0.51, 0.13, 1)
; PHYS-1 (2026-09-20), ruling P4. The damping above is Produce.tscn's own measured value and is
; NOT touched -- its header records why (an undamped sphere on a flat floor never stops; one
; rolled out of the room). What this adds is the contact half: friction 0.90 and `rough`, so an
; orange grips whatever it lands on instead of being multiplied down by it. See
; assets/physics/README.md for the whole table and why produce is the only `rough` member.
;
; No centre-of-mass override: a sphere has nowhere to put one.
physics_material_override = ExtResource("3_physmat")

[node name="Visual" type="Node3D" parent="."]

[node name="MeshInstance3D" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("SphereMesh_produce")
material_override = SubResource("StandardMaterial3D_produce")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("SphereShape3D_produce")

[node name="Interactable" type="Node" parent="."]
script = ExtResource("2_interactable")
