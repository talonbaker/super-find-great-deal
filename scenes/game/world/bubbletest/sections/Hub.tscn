[node name="Bubble_Seam_01" parent="Bubbles" instance=ExtResource("3_bubble")]
position = Vector3(0, 1.1, -43)

; ROOFTOP-1 (2026-09-05) - THE HUNDREDTH BUBBLE, MOVED RATHER THAN ADDED.
;
; Talon: "there is the very last bubble the 100 bubble and maybe it's on like a diving board so
; it's funny and the player can jump and catch the bubble". The level's total is exactly 100 and
; stays exactly 100, so the bubble on the board had to come from somewhere.
;
; THIS ONE, AND IT STAYS IN THIS FILE. BUBBLE-1 nominated it and every reason still holds:
;   - it was the most redundant thing in the level. Bubble_Seam_01 sits 3.8 m away at (0, 1.1,
;     -43), CENTRED on the north connector, doing the identical job; Seam_02 was the off-centre
;     second of a pair.
;   - seam bubbles belong to NO section (SeamBubbles' own doc says so; they live in Hub.tscn only
;     because the connectors do), so moving one makes no section's count a lie about where its
;     bubbles are - the semantic damage every other candidate would have caused.
;   - and it is why it did not move FILE. Bubble ids are the index of an ordinal NODE-PATH sort
;     (BubbleCounter.AdoptAuthoredBubbles), so this is a one-line `position` edit: same parent,
;     same name, same path, SAME ID 48. Nothing renumbers, nothing re-bakes, no constant moves.
;     Re-parenting it into TvRoom.tscn - where the board it hangs over is authored - would have
;     renumbered the level.
;
; WHERE IT IS NOW: world (0, 201.05, -15.9) - BubbleTestLayout.SkyBubblePos, and the hub's anchor
; is the origin so hub-local and world are the same numbers here. That is 1.05 m above the diving
; board's plank and 1.10 m short of its tip, i.e. standing-reachable by a player who walks out over
; a 200 m drop. See SkyBubblePos for why standing-reachable and not a jump: it is the hundredth
; bubble in the level and the one platform where a miss is a 3.3 s fall.
;
; CheckBubbleCensus still counts it as one of the hub's five SEAM bubbles, because it is still in
; Hub.tscn under Bubbles with the Bubble_Seam prefix - which is the whole reason the census splits
; by prefix rather than by position.
;
; The north path now keeps ONE marker (Seam_01, centred, unmoved), which was always the one a
; player follows; SeamBubbles' own doc has been corrected to say so.
[node name="Bubble_Seam_02" parent="Bubbles" instance=ExtResource("3_bubble")]
position = Vector3(0, 201.05, -15.9)

[node name="Bubble_Seam_03" parent="Bubbles" instance=ExtResource("3_bubble")]
position = Vector3(43, 1.1, 0)

[node name="Bubble_Seam_05" parent="Bubbles" instance=ExtResource("3_bubble")]
position = Vector3(0, 1.1, 45)

[node name="Bubble_Seam_07" parent="Bubbles" instance=ExtResource("3_bubble")]
position = Vector3(-45, 1.1, 0)
