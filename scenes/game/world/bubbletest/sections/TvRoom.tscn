; ---- RoomF, "the Deep Room" (EGG-2) ---------------------------------------------------------
; The sixth television's destination, and DELIBERATELY NOT A SIXTH DEN. It is the lake from the
; inside: pale silt underfoot, dark murk on the walls, and a ceiling that is the underside of the
; water with the daylight still coming through it. No couch, no picture wall, no lamp - the five
; rooms above already have those, and the reward for a drowning risk should not be the room the
; player has already seen five times.
;
; The palette is read off the section's own lake, not invented: green_ground/lake_murk sit in the
; same family, and the ceiling's emission is what makes "light through water" read without a
; light source, a shader or a second animator.
[sub_resource type="StandardMaterial3D" id="Mat_floor_F"]
resource_name = "room F silt floor"
albedo_color = Color(0.48, 0.47, 0.41, 1)
roughness = 1.0

