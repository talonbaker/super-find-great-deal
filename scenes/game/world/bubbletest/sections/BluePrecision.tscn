; A PlaneMesh, NOT a BoxMesh, and the first draft got this wrong in a way only a render showed.
; lake_murk.gdshader declares `render_mode ... cull_disabled`, so every face of a box is drawn --
; including its underside and its four 2 cm sides -- and a water shader shading the inside of a
; box over the top of itself renders the whole basin as a flat black rectangle. It looked exactly
; like "the murk is working", which is why it survived one capture. Green's lake is a flat 96-
; segment fan for the same reason; a single subdivided quad is the same thing at this scale, and
; the subdivisions exist because the shader displaces and shades per vertex.
[sub_resource type="PlaneMesh" id="BoxMesh_egg2_water"]
size = Vector2(50, 31)
subdivide_width = 24
subdivide_depth = 15

; LIGHTENED AFTER THE FIRST CAPTURE, and the reason is legibility rather than taste. At
; (0.16, 0.19, 0.21) the basin read as a black HOLE from the climb rather than as water: the murk
; shader's whole job is to hide the bottom by path length, and a bottom that is already black
; gives it nothing to hide, so the surface never resolved as a surface. A mid-value bed lets the
; extinction do the work and the plane reads as water at the rim and as depth in the middle -
; which is also the reading green's lake has, and "the same standard drowns-on-touch water used
; elsewhere in the level" is Talon's phrase for this thing.
[sub_resource type="StandardMaterial3D" id="Mat_egg2_bed"]
resource_name = "moat bed - silt under the climb"
albedo_color = Color(0.36, 0.38, 0.34, 1)
roughness = 1.0

