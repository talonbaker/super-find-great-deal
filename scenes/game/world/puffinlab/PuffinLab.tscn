position = Vector3(-4, 1, 4)

; East floor, clear of the worktop at root (3.864, 0.621, -7.176) and the south bench at (3.588,
; 0.58, 7.383).
[node name="Bubble_Lab_03" parent="Bubbles" instance=ExtResource("7_bubble")]
