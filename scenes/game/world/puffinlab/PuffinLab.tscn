[node name="Bubble_Lab_06" parent="Bubbles" instance=ExtResource("7_bubble")]
position = Vector3(14.628, -3.033, -17.733)

[node name="Bubble_Lab_07" parent="Bubbles" instance=ExtResource("7_bubble")]
position = Vector3(22.77, -5.614, -17.94)

; The long hallway: two, on stations "hallway 1" and "hallway 3", 1 m above a floor at -6.9 in a
; corridor 4.14 m wide and 4.42 m tall. Spaced 27.6 m apart so the hallway's length is the beat.
[node name="Bubble_Lab_08" parent="Bubbles" instance=ExtResource("7_bubble")]
