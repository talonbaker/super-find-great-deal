; The cap. A CylinderMesh's axis is its own +Y, so every Cap node is rotated a quarter turn about
; X to lie along the button's +Z — the twelve floats (1,0,0, 0,0,-1, 0,1,0) are that rotation
; written as basis ROWS, which is what a .tscn stores (.claude/rules/godot-scenes.md). At rest it
; stands 4 cm proud of the plate; RoundButton.CapTravelM is 4 cm, so a press takes it flush and
; the travel is legible without measuring.
[sub_resource type="CylinderMesh" id="CylinderMesh_cap"]
top_radius = 0.1
bottom_radius = 0.1
height = 0.06
radial_segments = 24

