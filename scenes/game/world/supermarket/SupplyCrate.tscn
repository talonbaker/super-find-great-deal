[sub_resource type="BoxShape3D" id="BoxShape3D_rim_x"]
size = Vector3(0.06, 0.2, 1.2)

[sub_resource type="BoxMesh" id="BoxMesh_rim_z"]
size = Vector3(1.4, 0.2, 0.06)

[sub_resource type="BoxShape3D" id="BoxShape3D_rim_z"]
size = Vector3(1.4, 0.2, 0.06)

[node name="SupplyCrate" type="Node3D"]

[node name="Plinth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)

[node name="Collision" type="CollisionShape3D" parent="Plinth"]
shape = SubResource("BoxShape3D_plinth")

[node name="Mesh" type="MeshInstance3D" parent="Plinth"]
