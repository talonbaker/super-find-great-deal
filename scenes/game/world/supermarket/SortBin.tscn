mesh = SubResource("BoxMesh_plate")
surface_material_override/0 = SubResource("Mat_plate")

; font_size 28 at the default pixel_size 0.005 is 0.14 m of glyph height, so the widest word
; either rule can produce -- YELLOW, six characters -- spans about 0.54 m across a 0.66 m plate at
; this font's measured 0.64 advance ratio (CLOCK-1 3.3 measured that ratio off a render; the
; arithmetic is pinned by SortRuleTests.EveryPlateWord_FitsThePlate and the RENDER is still the
; instrument).
[node name="PlateLabel" type="Label3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.7, -0.39)
text = "-"
font_size = 28

[node name="PlateIcon" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.92, -0.4)

[node name="IconCube" type="MeshInstance3D" parent="PlateIcon"]
mesh = SubResource("BoxMesh_icon_cube")
material_override = SubResource("Mat_icon")

[node name="IconBall" type="MeshInstance3D" parent="PlateIcon"]
mesh = SubResource("SphereMesh_icon_ball")
material_override = SubResource("Mat_icon")

[node name="IconCan" type="MeshInstance3D" parent="PlateIcon"]
mesh = SubResource("CylinderMesh_icon_can")
material_override = SubResource("Mat_icon")
