; DOOR-1 (2026-09-19) — the burst door's own resources.
;
; The arithmetic, once, so nobody has to re-derive it: the old +Z wall was 10.8 x 3.5 x 0.4
; centred at (0, 1.75, 5.2), i.e. x in [-5.4, 5.4] and y in [0, 3.5]. The opening is
; x in [-0.8, 0.8], y in [0, 2.2]. So each side piece is 4.6 wide (5.4 - 0.8) centred at
; +/-3.1, and the lintel is 1.6 wide by 1.3 high (3.5 - 2.2) centred at y = 2.85.

[sub_resource type="StandardMaterial3D" id="Mat_door"]
resource_name = "burst door leaf (the walls' own family, a shade darker)"
albedo_color = Color(0.46, 0.4, 0.36, 1)
roughness = 0.85

[sub_resource type="BoxMesh" id="BoxMesh_door_side"]
size = Vector3(4.6, 3.5, 0.4)

[sub_resource type="BoxShape3D" id="BoxShape3D_door_side"]
size = Vector3(4.6, 3.5, 0.4)

[sub_resource type="BoxMesh" id="BoxMesh_door_lintel"]
size = Vector3(1.6, 1.3, 0.4)

[sub_resource type="BoxShape3D" id="BoxShape3D_door_lintel"]
size = Vector3(1.6, 1.3, 0.4)

; The leaf is 4 cm narrower and 2 cm shorter than the opening so it never z-fights the frame,
; and 0.14 m thick inside a 0.4 m wall so it sits recessed like a real door in a reveal.
[sub_resource type="BoxMesh" id="BoxMesh_door_leaf"]
size = Vector3(1.56, 2.18, 0.14)

; The blocker fills the WHOLE opening, including the 4 cm the leaf leaves: a gap a player can
; be pushed into is a gap they can be stuck in.
[sub_resource type="BoxShape3D" id="BoxShape3D_door_blocker"]
size = Vector3(1.6, 2.2, 0.4)

