[gd_scene load_steps=23 format=3]

[ext_resource type="Script" path="res://scripts/game/world/BurstDoor.cs" id="1_burstdoor"]

; BASE-1 (2026-09-19) — THE TASK ROOM. 10 x 10 x 3.5 m interior box, same construction as
; HoldingRoom.tscn (read that file's header for the convention and for why nothing here may be
; built in code), PLUS a 3 x 3 x 3.5 m vestibule attached to the +Z wall.
;
; THE VESTIBULE IS WHERE THE SEEKER LANDS, AND "BurstDoor" IS THE WALL THAT STOPS BEING ONE.
; The seeker is teleported into the vestibule on the Found tick, already facing in, and the wall
; between them and the hiders bursts open.
;
; DOOR-1 (2026-09-19) REPLACED "WallZPos" WITH "BurstDoor", and the replacement keeps BASE-1's
; rule: from the task room it still reads as a full wall. The leaf fills the opening flush and
; carries the same albedo family as the walls, so a hider who looks at it sees a panel, not a
; door with a gap around it — BASE-1's reasoning, unchanged: a hider who can see a way in has
; already been told where the ending comes from, and the whole beat is that the instant is
; unknowable.
;
; WHAT THE PARTS ARE, AND WHY THERE ARE FOUR OF THEM.
;   FrameXNeg / FrameXPos / FrameLintel  the wall that is STILL a wall. Together they are exactly
;                                        the old WallZPos minus a 1.6 x 2.2 m hole, so the room is
;                                        no leakier than it was.
;   Hinge + Leaf                         the moving part: an empty at the hinge edge with a MESH
;                                        and NO COLLIDER hanging off it. BurstDoor tweens the
;                                        Hinge's Y rotation. A tween and not a hinge joint,
;                                        because program section 5 says a joint tunnels, and the
;                                        one thing it would tunnel through is a player.
;   Blocker                              the only collision this door has: a StaticBody3D filling
;                                        the opening, whose shape is DISABLED on the burst frame
;                                        on every peer and re-enabled at the end of the reset
;                                        close. Never moved, so it can never sweep through anyone.
;
; The leaf swings toward -Z, into the task room, into the hiders. At +110 deg about +Y the leaf's
; far edge lands at roughly (-1.33, *, 3.73) in this room's local space — inside the room and
; well clear of the frame. All twelve floats of every Transform3D below are basis ROWS
; (.claude/rules/godot-scenes.md); every one here is the identity basis plus a translation.
;
; The vestibule is sealed on its other three sides and has its own dimmer light, so a hider in
; the main room sees nothing of it even for the frames between the teleport and the burst.

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
resource_name = "task room floor (warm grey)"
albedo_color = Color(0.38, 0.33, 0.3, 1)
roughness = 0.9

