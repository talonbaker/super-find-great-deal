[node name="Body" parent="Stock/Bin_5" instance=ExtResource("12_bin")]

; --- forty-eight cereal boxes, aisles 1 and 3 --------------------------------------------------
; CerealBox.tscn, 0.19 x 0.28 x 0.06, 0.4 kg, cardboard voice. Eight per shelf as two runs of
; four at 0.24 m centres, the runs staggered to a different pair of bays on each of the three
; levels and alternating between the front and back half of the 0.5 m depth, so the aisle reads
; stocked from either side and from either end. y is the board's top surface plus the product's
; own half-height, so every one of them starts RESTING rather than dropping 8 cm on the first
; physics tick.

[node name="Box_000" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.81, 0.565, -1.16)
