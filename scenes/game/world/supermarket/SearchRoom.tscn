albedo_color = Color(0.31, 0.36, 0.32, 1)
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="Mat_wall"]
resource_name = "search room walls (cool green-grey)"
albedo_color = Color(0.43, 0.5, 0.44, 1)
