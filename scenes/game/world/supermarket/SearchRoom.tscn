script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_2" instance=ExtResource("12_bin")]

[node name="Bin_3" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.4, 0, -4.3)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_3" instance=ExtResource("12_bin")]

[node name="Bin_4" type="Node3D" parent="Stock"]
