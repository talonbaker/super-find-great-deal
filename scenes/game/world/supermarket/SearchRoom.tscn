; THE TWO END-CAPS, rotated 90 deg about Y so their 1.4 m length runs along z and their 0.5 m
; depth faces the cross-aisle — a display you walk past rather than into, which is what an
; end-cap is. EndCap.tscn is symmetric about both horizontal axes, so +90 and -90 occupy the
; identical volume and the basis-row trap in .claude/rules/godot-scenes.md cannot bite here;
; it still got a headed look (docs/qa/2026-09-19-shelf-1/). They close two DIFFERENT aisles at
; OPPOSITE ends, so neither cross-aisle is blocked twice — aisle 1 at +X and aisle 3 at -X. The
; first cut put EndCap_0 on aisle 0; the note on that node says which suite moved it and why.

; EndCap_0 closes the SECOND aisle rather than the first, and that is not a look: bot D of
; Run-PlaceTest carries a crate from Prop_2 to the +X wall at z = -3 to stage the out-of-bounds
; refusal, and an end-cap on aisle 1 sat exactly on that diagonal. Measured — the bot stopped
; dead at world x = 44.45, 15 cm short of the end-cap's face, and the suite reported a refusal
; that never happened. A walk brain that goes in a straight line makes every piece of furniture
; in the room part of another lane's staging.
[node name="EndCap_0" parent="." instance=ExtResource("11_endcap")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 4.85, 0, -1.05)

[node name="EndCap_1" parent="." instance=ExtResource("11_endcap")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -4.85, 0, 3.15)

; =============================================================================================
; THE STOCK. Every authored PROP in this room that SHELF-1 added lives under this one node, and
; the node exists for a reason that is not tidiness.
;
; PropManager.AdoptAuthoredProps assigns ids by ORDINAL NODE-PATH SORT starting at 1000, so the
; id of every prop in the world depends on the name of every other one. CARRY-1's four crates
; are Prop_0..Prop_3 at ids 1000..1003 and tests/Run-PlaceTest.ps1 names all four of those
; numbers in its own source. "Bin_", "Box_", "Can_" and "Produce_" all sort BEFORE "Prop_", so
; putting 126 new props beside them in this room would have renumbered CARRY-1's four and
; turned another lane's suite red for a reason nobody would have found from the diff.
; "Stock/..." sorts AFTER "Prop_" ('S' > 'P'), so the crates keep 1000..1003 and the shop floor
; takes one contiguous block above them:
;
;     1000..1003   Prop_0..Prop_3    CARRY-1's crates, unmoved
;     1004..1009   Stock/Bin_0..5    the six floor bins
;     1010..1057   Stock/Box_000..047
;     1058..1105   Stock/Can_000..047
;     1106..1129   Stock/Produce_000..023
;
; The numbering above is ASSERTED, not assumed: tests/Run-AuthoredPropTest.ps1 checks the whole
; block on a server and on a late-joining client and was proved able to fail by renaming one
; product node. If you add, remove or rename anything under here, that suite is the thing that
; tells you what you moved.
;
; NAMES ARE ZERO-PADDED TO THREE DIGITS for the same reason: an ordinal sort puts "Can_10"
; between "Can_1" and "Can_2", so unpadded names would give an id order that is not the reading
; order and a level author would be wrong about which object they were looking at.
;
; STRUCTURE of each entry is CARRY-1's, and the name "Body" is not cosmetic: NetworkedProp._Ready
; BINDS that child rather than building one.

[node name="Stock" type="Node3D" parent="."]

; --- the six floor bins ----------------------------------------------------------------------
; FloorBin.tscn: 0.9 x 0.6 x 0.9 open-top tubs, 6 kg, RigidBody3D NetworkedProps — tippable and
; carryable, which is the packet's point: a bin knocked over is somewhere an object can end up
; and somewhere it can be hidden under. They stand in the two cross-aisles, clear of the
; end-caps and of SearchPillar, and y = 0 because the prefab's origin is its base.

[node name="Bin_0" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.4, 0, -4.3)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_0" instance=ExtResource("12_bin")]

; Bin_1 sits at +1.05 rather than the mirror of Bin_4: Run-PlaceTest's bot D walks from Prop_2
; to the -X cross-aisle to try a placement outside the room, and a bin on that diagonal is a
; 6 kg obstacle the walk brain cannot go round.
[node name="Bin_1" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.4, 0, 1.05)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_1" instance=ExtResource("12_bin")]

[node name="Bin_2" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.4, 0, 4.3)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_2" instance=ExtResource("12_bin")]

[node name="Bin_3" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.4, 0, -4.3)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_3" instance=ExtResource("12_bin")]

[node name="Bin_4" type="Node3D" parent="Stock"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.4, 0, 0)
script = ExtResource("2_netprop")

[node name="Body" parent="Stock/Bin_4" instance=ExtResource("12_bin")]

[node name="Bin_5" type="Node3D" parent="Stock"]
