; TANGLE GOAL -- HSV(300, 0.86, 0.555). Chroma 0.477. Palette header: `tangle_ground.tres`.
;
; ONE SURFACE IN THE WHOLE SECTION WEARS THIS: the last stair tread. That is the entire marked
; area of a 107-block pile, and the restraint is the design rather than an economy. The zone's
; own brief is "many routes, none of them marked" -- a coloured route would hand the player the
; menu the tangle exists to withhold. What the goal colour marks is not the route but its END:
; the tread the promise finishes on, under the bubble, read from the ground as a single violet
; chip at the top of a grey pile.
; RUNG 3. Measured L* = 34.28.
[gd_resource type="StandardMaterial3D" format=3]

[resource]
albedo_color = Color(0.555, 0.078, 0.555, 1)
roughness = 0.62
metallic = 0.0
metallic_specular = 0.35
