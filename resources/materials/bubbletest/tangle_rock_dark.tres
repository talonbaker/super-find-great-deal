; TANGLE ROCK, DARK -- rung 2 minus 5.0 L*. See `tangle_rock_light.tres` for why the three rock
; tones exist and why they are compressed to +/-5 L* rather than carried over at the lab's
; spread. Palette header: `tangle_ground.tres`.
;
; The lab's note on this tone: "scree -- visually busier, reads as less certain". It is worn by
; the three canted slabs over the approach and by a quarter of the stack, which is what keeps
; the looming geometry from reading as the same mass as the ground-level rubble.
; Rung 2 - 5.0. Measured L* = 19.39.
[gd_resource type="StandardMaterial3D" format=3]

[resource]
albedo_color = Color(0.184, 0.184, 0.187, 1)
roughness = 0.88
metallic = 0.0
metallic_specular = 0.35
