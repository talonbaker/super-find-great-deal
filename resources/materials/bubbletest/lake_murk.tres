; BT-9. THE LAKE. "Murky depths, a bit ominous" (Talon).
;
; Directed by `/direct` 2026-08-27 -- THRILL-BIBLE §12, "Bubble-test lake". The gate result is
; ATMOSPHERE, NOT DREAD (§2.2 fails: nothing in this level approaches), and the two constitutive
; constraints are written out in `lake_murk.gdshader`'s header. Read them before changing a number
; here -- one of the four overrides below exists for the direction rather than for the look.
;
; FOUR OVERRIDES, AND ONLY FOUR. The shader is a strict superset of Sail's shipped water and its
; defaults are already tuned; per `water_surface.tres`'s stated rule, this file changes only what
; it means to change and leaves the rest to the shader so there is one place to tune it.
; `silt_scatter` (1.0) and `silt_density` (1.7) are NOT overridden -- the lab already ruled those
; and together they ARE the murk pass; re-typing them here would fork them silently.
[gd_resource type="ShaderMaterial" load_steps=3 format=3]

[ext_resource type="Shader" path="res://resources/shaders/lake_murk.gdshader" id="1_murk"]
[ext_resource type="Texture2D" path="res://assets/materials/water/water_normal.png" id="2_normal"]

[resource]
render_priority = 0
shader = ExtResource("1_murk")
shader_parameter/normal_map = ExtResource("2_normal")

; (1) THE COLOUR THE MURK GOES TO. Lab default is (0.255, 0.285, 0.230), a grey-green. Pulled
; browner and down a step to a tannic olive -- the direction's words are "dark green-brown", and
; the §6.6 colour-temperature spend recorded in the ledger is precisely that this is the ONE
; surface in the level graded away from the toy palette. The shader clamps blue to green
; internally, so this cannot be dragged cool no matter what is typed here.
shader_parameter/silt_col = Color(0.208, 0.216, 0.158, 1)

; (2) SIGHTLINE. One multiplier on the day/night extinction PAIR, so the authored day:night ratio
; survives a change here. LARGER = you see further; 1.0 is the shipped sightline exactly. 0.62
; closes every depth in the shipped table to ~62% of it: the bed at -3.5 m is long gone, which is
; "murky depths", while the first half-metre stays readable -- which is §7.1's requirement that
; opacity never hide a traversal affordance. Note the stepping stones sit at +0.25..+0.45, i.e.
; ABOVE the surface, so they are never subject to this at all; the requirement bites only on their
; submerged bases and on the shoreline.
shader_parameter/sightline_scale = 0.62

; (3) THE SHALLOW VEIL. Depth-INDEPENDENT cloudiness, 0.0 = off (the shipped state). Part 1 of the
; murk is a function of path length and therefore necessarily goes to zero at the waterline, which
; leaves a glassy margin at every shore -- and a glassy margin around a murky lake reads as a bug
; rather than as shallow water. 0.22 is a floor, not a fog: enough that the ankle-deep edge is
; already slightly cloudy. Kept low because the veil is the one murk term that can plant a hard
; intersection line along the whole beach if it is pushed.
shader_parameter/turbidity_veil = 0.22

; (4) HOW MUCH MURK THE NIGHT KEEPS. Lab default 0.35. THIS IS THE OVERRIDE THAT EXISTS FOR THE
; DIRECTION. Constraint (a) in the shader header: the water must read as a DENIAL of depth, not as
; a dark texture -- a player must be unable to tell how far the bottom is while staying certain
; there IS one, and a flat black surface fails that by reading as painted floor. Scattering is the
; only term in this shader that ADDS light back, so at night it is the only thing keeping the water
; a value above black. 0.50 buys that margin.
;
; IT IS NOT A NIGHT-FLOOR CHANGE. `OutdoorAtmosphere.NightAmbientFloor` is untouched by this branch
; and THRILL-BIBLE §6.2 is not resolved here -- the ledger entry records this as "leaned on, not
; resolved" and all four sides of that fork stay reachable.
shader_parameter/silt_night_scale = 0.50
