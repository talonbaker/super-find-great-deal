[gd_resource type="PhysicsMaterial" format=3 uid="uid://physwood0sfgdmvp"]

; PHYS-1 (2026-09-20). A CRATE, and every prop whose material resolves to Wood -- the foundation's
; default voice, so this is also the value an unclassified prop gets.
;
; 0.60 sits between the can's roll and the box's grip on purpose: a crate shoved across a board
; slides a hand's width and stops. It is the heaviest carryable in the game (1 kg against a can's
; 0.35), so it is the one a player uses to knock things over, and a crate that skidded would put
; its own momentum into the floor instead of into the stack.
;
; Zero bounce: a wooden crate lands with a thud, which is exactly what its sound profile says.
[resource]
friction = 0.6
rough = false
bounce = 0.0
absorbent = false
